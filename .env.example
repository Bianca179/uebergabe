# Übergabe – Umgebungsvariablen
# Lokal: in .env.local kopieren. Vercel: Project → Settings → Environment Variables.

# Pflicht
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=

# Stimme (ElevenLabs voice_id). Standard: "Uebergabe Paul". Änderbar in den Einstellungen der App.
ELEVENLABS_VOICE_ID=RqYtbPVBBytc1OIowrh0

# Zugangscode für die App. Leer = kein Login (nur lokal sinnvoll).
APP_ACCESS_CODE=

# Datenbank (Neon Postgres, wird von Vercel automatisch gesetzt). Leer = lokale PGlite-Datei unter .data/pg
DATABASE_URL=

# Audio-Speicher (Vercel Blob, wird von Vercel automatisch gesetzt). Leer = lokale Dateien unter .data/audio
BLOB_READ_WRITE_TOKEN=
